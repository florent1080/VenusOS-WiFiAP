#!/bin/bash

# VenusOS-WiFiAP setup script
# WiFi Access Point for Venus OS on Raspberry Pi - Cerbo GX-style,
# concurrent STA+AP (validated on Pi 5 / BCM43455 / Venus 3.75).
#
# Architecture (v2):
#   - Installs a service TEMPLATE at /opt/victronenergy/service-templates/hostapd/
#     plus the empty marker /opt/victronenergy/service-templates/conf/hostapd.conf.
#     That marker is venus-platform's gate (templateExists): once present,
#     venus-platform publishes com.victronenergy.platform /Services/AccessPoint/Enabled
#     (which makes the "Create access point" toggle appear in BOTH GUIs, under
#     Settings > Wi-Fi), creates /Settings/Services/AccessPoint (default 1) and
#     installs/removes /service/hostapd through svectl when it changes.
#   - The template run execs /data/VenusOS-WiFiAP/files/wifi-ap-run, which
#     creates ap0 NEXT TO the wlan0 station and starts the AP with the image's
#     wpa_supplicant in AP mode (CONFIG_AP) - hostapd is NOT needed and is not
#     shipped on the Raspberry Pi images.
#   - Password: /Settings/Services/AccessPointPassword (declared here via
#     AddSettings, watched natively by venus-platform which restarts the
#     service on change), falling back to PASSWORD in /data/wifi-ap/wifi-ap.conf.
#
# On uninstall: disables the AP, removes the template (or restores the stock
# one when the image shipped one), tears down ap0/NAT/DHCP leftovers.

packageDir="$(dirname "$(realpath "$0")")"
INSTALL_DIR="/data/wifi-ap"
CONF_SRC="$packageDir/wifi-ap.conf"
CONF_DST="$INSTALL_DIR/wifi-ap.conf"
ENGINE="$packageDir/files/wifi-ap-run"
TEMPLATE_DIR="/opt/victronenergy/service-templates/hostapd"
TEMPLATE_CONF="/opt/victronenergy/service-templates/conf/hostapd.conf"
TEMPLATE_RUN_SRC="$packageDir/files/hostapd-template/run"
TEMPLATE_LOG_SRC="$packageDir/files/hostapd-template/log/run"
TEMPLATE_BACKUP="$INSTALL_DIR/hostapd-template.orig"

#### following line incorporates helper resources into this script
source "/data/SetupHelper/HelperResources/IncludeHelpers"
#### end of lines to include helper resources

set +e

#### running manually and target just install or uninstall
if [ $scriptAction == 'NONE' ] ; then
    echo
    echo "This package creates a Cerbo GX-style WiFi Access Point on Venus OS"
    echo "Raspberry Pi images (concurrent with the WiFi client connection)."
    echo "The native toggle appears in Settings > Wi-Fi > Create access point"
    echo "Edit /data/wifi-ap/wifi-ap.conf to set SSID and password"
    echo
    # sets scriptAction in the current shell - must NOT be wrapped in $(...)
    standardActionPrompt
fi

# --- INSTALL -----------------------------------------------------------------
if [ $scriptAction == 'INSTALL' ] ; then
    logMessage "installing VenusOS-WiFiAP"

    # Create install directory and install config (preserve existing)
    mkdir -p "$INSTALL_DIR"
    if [ ! -f "$CONF_DST" ]; then
        cp "$CONF_SRC" "$CONF_DST"
        sed -i 's/\r//g' "$CONF_DST"
        logMessage "default config installed: $CONF_DST"
    else
        logMessage "config already exists, preserved: $CONF_DST"
    fi

    # The AP engine stays in the package dir (survives Venus OS updates via
    # PackageManager reinstall). Strip CR defensively: a CRLF shebang means
    # "bad interpreter: /bin/sh^M" on BusyBox.
    sed -i 's/\r//g' "$ENGINE" "$TEMPLATE_RUN_SRC" "$TEMPLATE_LOG_SRC"
    chmod +x "$ENGINE"

    # --- Install the hostapd service template.
    # If the image shipped a native template (Cerbo-like images), back up its
    # run script once and replace it; on Raspberry Pi images the whole
    # directory is created from scratch.
    if [ -f "$TEMPLATE_DIR/run" ] && ! grep -q "VenusOS-WiFiAP" "$TEMPLATE_DIR/run"; then
        if [ ! -f "$TEMPLATE_BACKUP" ]; then
            cp "$TEMPLATE_DIR/run" "$TEMPLATE_BACKUP"
            logMessage "backed up native hostapd template -> $TEMPLATE_BACKUP"
        fi
    fi
    mkdir -p "$TEMPLATE_DIR/log"
    cp "$TEMPLATE_RUN_SRC" "$TEMPLATE_DIR/run"
    cp "$TEMPLATE_LOG_SRC" "$TEMPLATE_DIR/log/run"
    # point the template at the engine wherever the package actually lives
    # (a clone named e.g. VenusOS-WiFiAP-main would otherwise crash-loop)
    sed -i "s|/data/VenusOS-WiFiAP/files/wifi-ap-run|$ENGINE|" "$TEMPLATE_DIR/run"
    chmod +x "$TEMPLATE_DIR/run" "$TEMPLATE_DIR/log/run"
    if [ ! -f "$TEMPLATE_CONF" ]; then
        touch "$TEMPLATE_CONF"
        logMessage "created template marker $TEMPLATE_CONF"
    fi
    logMessage "hostapd service template installed"

    # --- Declare the password setting (the one venus-platform watches and the
    # gui-v2 password field edits). Harmless if it already exists.
    dbus -y com.victronenergy.settings / AddSettings \
        '%[{"path": "/Settings/Services/AccessPointPassword", "default": ""}]' >/dev/null 2>&1 \
        && logMessage "declared /Settings/Services/AccessPointPassword" \
        || logMessage "NOTE: AddSettings AccessPointPassword failed (non blocking)"

    # --- Legacy cleanup (older package versions) ------------------------------
    # v1 installed a hostapd-native service and later a no-op wifi-ap service
    # via SetupHelper. Both are gone since v2: the AP service is the
    # native-style /service/hostapd, installed on demand by venus-platform/
    # svectl. (The only SetupHelper-managed service is now wifi-watchdog.)
    # Note: /service/ is a bind mount of /run/overlays/service/ (tmpfs), a
    # copy of /opt/victronenergy/service/ made at boot by overlays.sh -
    # removing only the runtime entry is not enough, the persistent ext4
    # source must go too or it reappears on the next boot.
    for legacy in hostapd-native wifi-ap; do
        for legacyDir in "/service/$legacy" "/opt/victronenergy/service/$legacy" "/run/overlays/service/$legacy"; do
            if [ -d "$legacyDir" ] || [ -L "$legacyDir" ]; then
                svc -dx "/service/$legacy/log" 2>/dev/null || true
                svc -dx "/service/$legacy" 2>/dev/null || true
                sleep 2
                rm -rf "$legacyDir"
                logMessage "removed legacy $legacyDir"
            fi
        done
    done

    # --- Make venus-platform pick the template up.
    # templateExists() is evaluated at venus-platform startup only, so restart
    # it whenever the node is missing. That includes the reinstall after a
    # firmware update: at boot, PackageManager reinstalls packages AFTER
    # venus-platform has already started, so the restart is needed there too.
    if ! dbus -y com.victronenergy.platform /Services/AccessPoint/Enabled GetValue >/dev/null 2>&1; then
        logMessage "restarting venus-platform to publish /Services/AccessPoint"
        svc -t /service/venus-platform 2>/dev/null || true
        sleep 8
        if dbus -y com.victronenergy.platform /Services/AccessPoint/Enabled GetValue >/dev/null 2>&1; then
            logMessage "AccessPoint published on com.victronenergy.platform"
        else
            logMessage "WARNING: /Services/AccessPoint still absent - a reboot should fix it"
        fi
    elif svstat /run/service/hostapd 2>/dev/null | grep -q ": up"; then
        # package update while the AP is running: restart it so the new
        # engine takes effect now instead of at the next toggle/reboot
        svc -t /service/hostapd 2>/dev/null || true
        logMessage "restarted the running AP to apply the updated engine"
    fi

    logMessage "VenusOS-WiFiAP install complete"
    logMessage "AP SSID/fallback password: edit $CONF_DST (then toggle the AP off/on, or: svc -t /service/hostapd)"
    logMessage "Toggle the AP in the UI: Settings > Wi-Fi > Create access point"
    logMessage "NOTE: venus-platform creates /Settings/Services/AccessPoint with default 1: the AP starts enabled"
fi

# --- UNINSTALL ---------------------------------------------------------------
if [ $scriptAction == 'UNINSTALL' ] ; then
    logMessage "uninstalling VenusOS-WiFiAP"

    # Disable the AP first: venus-platform removes /service/hostapd via svectl -r
    dbus -y com.victronenergy.settings /Settings/Services/AccessPoint SetValue 0 2>/dev/null || true
    sleep 3

    # Belt and braces in case venus-platform is not running: mirror svectl -r
    if [ -e /service/hostapd ] || [ -d /run/service/hostapd ]; then
        rm -f /service/hostapd
        svc -dx /run/service/hostapd/log 2>/dev/null || true
        svc -dx /run/service/hostapd 2>/dev/null || true
        rm -rf /run/service/hostapd
        logMessage "removed /service/hostapd"
    fi

    # Remove our template - or restore the native one where it existed
    if [ -f "$TEMPLATE_BACKUP" ]; then
        cp "$TEMPLATE_BACKUP" "$TEMPLATE_DIR/run"
        chmod +x "$TEMPLATE_DIR/run"
        rm -f "$TEMPLATE_BACKUP"
        logMessage "restored native hostapd template"
    elif grep -q "VenusOS-WiFiAP" "$TEMPLATE_DIR/run" 2>/dev/null; then
        rm -rf "$TEMPLATE_DIR"
        rm -f "$TEMPLATE_CONF"
        logMessage "removed hostapd template + marker"
    fi

    # Clean up any remaining ap0 interface, NAT rules, DHCP, wpa_supplicant AP
    kill $(ps | grep "wpa_supplicant -i ap0" | grep -v grep | awk '{print $1}') 2>/dev/null || true
    kill "$(cat /run/wifi-ap/dnsmasq.pid 2>/dev/null)" 2>/dev/null || true
    kill "$(cat /var/run/dnsmasq-ap0.pid 2>/dev/null)" 2>/dev/null || true
    ip link set ap0 down 2>/dev/null || true
    iw dev ap0 del 2>/dev/null || true
    AP_IP="$(grep '^AP_IP=' "$CONF_DST" 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d "'")"
    AP_IP="${AP_IP:-192.168.0.1}"
    AP_NET="$(echo "$AP_IP" | cut -d. -f1-3).0/24"
    iptables -t nat -D POSTROUTING -s "$AP_NET" ! -d "$AP_NET" -j MASQUERADE 2>/dev/null || true
    iptables -D FORWARD -i ap0 -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -o ap0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
    iptables -t mangle -D FORWARD -s "$AP_NET" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
    for up in wwan0 eth0 wlan0; do
        iptables -t nat -D POSTROUTING -o "$up" -j MASQUERADE 2>/dev/null || true
        iptables -t nat -D POSTROUTING -s "$AP_NET" -o "$up" -j MASQUERADE 2>/dev/null || true
        iptables -D FORWARD -i ap0 -o "$up" -j ACCEPT 2>/dev/null || true
        iptables -D FORWARD -i "$up" -o ap0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
        iptables -t mangle -D FORWARD -o "$up" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
    done
    rm -rf /run/wifi-ap

    # Restart venus-platform so /Services/AccessPoint disappears from D-Bus
    svc -t /service/venus-platform 2>/dev/null || true

    # wifi-ap.conf preserved (user data)
    logMessage "config preserved: $CONF_DST"
    logMessage "VenusOS-WiFiAP uninstalled"
fi

# installs/removes services/wifi-watchdog (the AP service itself is NOT here:
# venus-platform/svectl owns /service/hostapd)
endScript INSTALL_SERVICES
