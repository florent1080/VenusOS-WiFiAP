#!/bin/sh
# VenusOS-WiFiAP - service template "hostapd"
#
# Installed by the package at /opt/victronenergy/service-templates/hostapd/run
# (together with an empty marker /opt/victronenergy/service-templates/conf/hostapd.conf).
# venus-platform only publishes /Services/AccessPoint/Enabled - the toggle the
# GUI shows under Settings > Wi-Fi > "Create access point" - when that marker
# exists; toggling installs/removes /service/hostapd through svectl, which
# runs this script. Same file layout as Victron's own template on a Cerbo GX,
# but the engine uses wpa_supplicant in AP mode: hostapd does not exist on the
# Raspberry Pi images.
echo "*** starting wifi-ap (hostapd service) ***"
exec 2>&1
. /etc/profile.d/profile.sh
exec /data/VenusOS-WiFiAP/files/wifi-ap-run
